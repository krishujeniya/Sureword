{
  "version": "1.0.0",
  "domain": "household_visit",
  "fields": {
    "person_name": {
      "type": "string",
      "required": true,
      "min_length": 2,
      "max_length": 50,
      "description": "Fictional person or patient full name"
    },
    "age": {
      "type": "integer",
      "required": true,
      "min_value": 1,
      "max_value": 120,
      "description": "Age in completed years"
    },
    "village": {
      "type": "string",
      "required": true,
      "min_length": 2,
      "max_length": 50,
      "description": "Village or hamlet name"
    },
    "visit_date": {
      "type": "date_iso8601",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "Explicit visit date"
    }
  }
}

# Gnani API Credentials (Required for live speech calls)
# Obtain from the Gnani challenge dashboard. DO NOT paste keys into public git or chat.
GNANI_API_KEY=your_gnani_api_key_here

# Provider Endpoints & Models
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Bhavna
GNANI_LANGUAGE=hi-IN

# Application & Networking Settings
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=https://krishujeniya.github.io,http://127.0.0.1:8000,http://localhost:8000
MAX_RECORDING_SECONDS=20
MAX_UPLOAD_BYTES=10485760

# Persistent Production Storage (PostgreSQL for Vercel / Cloud deployments)
# e.g., Neon serverless Postgres: postgres://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# If DATABASE_URL starts with postgres:// or postgresql://, Sureword automatically uses asyncpg with connection pooling.
# If omitted or pointing to a file, local SQLite (DATABASE_PATH) is used.
DATABASE_URL=
DATABASE_PATH=sureword.db

# Offline Development & Testing
# When set to true, requests without a valid GNANI_API_KEY will gracefully use deterministic test fixtures
ALLOW_FIXTURE_FALLBACK=true
